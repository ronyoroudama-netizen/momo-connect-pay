# Copiez ce fichier en ".env" et remplissez vos vraies valeurs. Ne commitez jamais le .env réel.

PORT=3000

# Fournie automatiquement par Railway/Render dès que vous ajoutez une base PostgreSQL au projet
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mettre à "off" seulement en local si votre Postgres local ne supporte pas SSL
PGSSL=off

# Mot de passe pour se connecter à l'espace admin (remplacer "2026" du prototype)
ADMIN_PASSWORD=change-moi

# Clé secrète utilisée pour signer les jetons de session admin (générer une longue chaîne aléatoire)
JWT_SECRET=change-moi-aussi-une-longue-chaine-aleatoire

# Origine(s) autorisée(s) à appeler l'API (votre site), séparées par une virgule
CORS_ORIGIN=https://momoconnect.fr,https://paiement.momoconnect.fr
